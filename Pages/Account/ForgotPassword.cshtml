@page
@model LaGrandeurSpa.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["HideNavigation"] = true;
}

<div class="spa-register-shell spa-account-security-shell">
    <div class="spa-auth-card spa-register-card spa-security-card">
        <div class="text-center mb-4">
            <img src="~/img/la-grandeur-logo.jpeg" class="spa-register-logo" alt="La Grandeur Spa" />
            <span class="spa-kicker d-block mt-3">ACCOUNT RECOVERY</span>
            <h1 class="spa-register-title">Forgot your password?</h1>
            <p class="text-muted">Enter the email address linked to your account and we’ll send you a secure reset link.</p>
        </div>

        @if (Model.RequestSubmitted)
        {
            <div class="spa-toast-message success static-message">
                <i class="fa-solid fa-envelope-circle-check"></i>
                <span>If an active account matches that email address, a password-reset link has been sent. Please also check Spam or Promotions.</span>
            </div>
            <a asp-page="/Account/Login" class="btn spa-btn-primary w-100 mt-3">Back to sign in</a>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">Email address</label>
                    <div class="spa-input-wrap">
                        <i class="fa-regular fa-envelope"></i>
                        <input asp-for="Input.Email" class="form-control spa-input" autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn spa-btn-primary w-100"><i class="fa-regular fa-paper-plane me-2"></i> Send reset link</button>
                <div class="text-center mt-3">
                    <a asp-page="/Account/Login" class="spa-text-link"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
