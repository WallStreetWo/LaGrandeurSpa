@page
@model LaGrandeurSpa.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Booking Calendar";
    var firstDay = new DateTime(Model.Year, Model.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
    var leading = (int)firstDay.DayOfWeek;
    var previous = firstDay.AddMonths(-1);
    var next = firstDay.AddMonths(1);
    var today = Model.TodayLocal;
}

<div class="spa-content-shell">
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="spa-toast-message success"><i class="fa-solid fa-circle-check"></i><span>@Model.StatusMessage</span></div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="spa-toast-message danger"><i class="fa-solid fa-circle-exclamation"></i><span>@Model.ErrorMessage</span></div>
    }

    <section class="spa-dashboard-hero">
        <div>
            <span class="spa-kicker">WELCOME BACK, @Model.CurrentUser.FullName.ToUpperInvariant()</span>
            <h1>Make time for <em>you.</em></h1>
            <p>Choose your treatment, find an open slot and let La Grandeur take care of the rest.</p>
        </div>
        <button class="btn spa-btn-primary spa-book-now-btn" data-bs-toggle="modal" data-bs-target="#bookingModal">
            <i class="fa-regular fa-calendar-plus"></i> Book now
        </button>
    </section>

    <div class="spa-dashboard-grid">
        <section class="spa-card spa-calendar-card">
            <div class="spa-calendar-toolbar">
                <div>
                    <span class="spa-kicker">BOOKING CALENDAR</span>
                    <h2>@firstDay.ToString("MMMM yyyy")</h2>
                </div>
                <div class="spa-calendar-nav">
                    <a asp-page="/Index" asp-route-year="@previous.Year" asp-route-month="@previous.Month" class="spa-icon-btn" aria-label="Previous month"><i class="fa-solid fa-chevron-left"></i></a>
                    <a asp-page="/Index" class="spa-today-link">Today</a>
                    <a asp-page="/Index" asp-route-year="@next.Year" asp-route-month="@next.Month" class="spa-icon-btn" aria-label="Next month"><i class="fa-solid fa-chevron-right"></i></a>
                </div>
            </div>

            <div class="spa-calendar-weekdays">
                @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                {
                    <div>@dayName</div>
                }
            </div>

            <div class="spa-calendar-grid">
                @for (var i = 0; i < leading; i++)
                {
                    <div class="spa-calendar-day is-empty"></div>
                }
                @for (var day = 1; day <= daysInMonth; day++)
                {
                    var date = new DateTime(Model.Year, Model.Month, day);
                    var events = Model.BookingsForDay(date).ToList();
                    var isSelected = date.Date == Model.SelectedDate.Date;
                    var isToday = date.Date == today.Date;
                    <a asp-page="/Index"
                       asp-route-year="@Model.Year"
                       asp-route-month="@Model.Month"
                       asp-route-selectedDate="@date.ToString("yyyy-MM-dd")"
                       asp-route-serviceId="@Model.SelectedServiceId"
                       class="spa-calendar-day @(isSelected ? "is-selected" : "") @(isToday ? "is-today" : "")">
                        <div class="spa-calendar-day-number">@day</div>
                        <div class="spa-calendar-events">
                            @foreach (var booking in events.Take(3))
                            {
                                <span class="spa-calendar-event" style="--event-color:@booking.SpaService.ColorHex" title="Booked: @booking.BookedServiceName at @booking.StartLocal.ToString("HH:mm")">
                                    <i></i><span>@booking.StartLocal.ToString("HH:mm") @booking.BookedServiceName</span>
                                </span>
                            }
                            @if (events.Count > 3)
                            {
                                <small>+@(events.Count - 3) more</small>
                            }
                        </div>
                    </a>
                }
            </div>

            <div class="spa-service-legend">
                @foreach (var service in Model.Services.GroupBy(x => x.Name).Select(x => x.First()))
                {
                    <span><i style="background:@service.ColorHex"></i>@service.Name</span>
                }
            </div>
        </section>

        <aside class="spa-card spa-day-panel">
            <div class="spa-day-panel-heading">
                <span class="spa-kicker">@Model.SelectedDate.ToString("dddd").ToUpperInvariant()</span>
                <h2>@Model.SelectedDate.ToString("dd MMMM")</h2>
                <p>See booked periods without exposing another customer's details.</p>
            </div>

            <div class="spa-private-schedule">
                <h3>Already booked</h3>
                @if (!Model.SelectedDateBookings.Any())
                {
                    <p class="spa-muted-box">No bookings yet for this date.</p>
                }
                else
                {
                    @foreach (var booking in Model.SelectedDateBookings.OrderBy(x => x.StartLocal))
                    {
                        var mine = booking.CustomerId == Model.CurrentUser.Id;
                        <div class="spa-schedule-row">
                            <span class="spa-schedule-color" style="background:@booking.SpaService.ColorHex"></span>
                            <div>
                                <strong>@booking.StartLocal.ToString("HH:mm") – @booking.EndLocal.ToString("HH:mm")</strong>
                                <small>@booking.BookedServiceName @(mine ? "· Your booking" : "· Booked")</small>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="spa-availability-preview">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <h3 class="mb-0">Available slots</h3>
                    <select id="previewService" class="form-select form-select-sm spa-select compact-select">
                        @foreach (var service in Model.Services)
                        {
                            <option value="@service.Id" selected="@(service.Id == Model.SelectedServiceId)">@service.Name · @service.DurationMinutes min</option>
                        }
                    </select>
                </div>
                <div id="previewSlots" class="spa-slot-grid">
                    @if (!Model.SelectedDateSlots.Any())
                    {
                        <span class="spa-no-slots">No available slots</span>
                    }
                    else
                    {
                        @foreach (var slot in Model.SelectedDateSlots)
                        {
                            <button type="button" class="spa-slot-pill js-book-slot" data-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" data-time="@slot.Value">@slot.Value</button>
                        }
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

<div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content spa-modal">
            <div class="modal-header">
                <div>
                    <span class="spa-kicker">LA GRANDEUR SPA</span>
                    <h2 class="modal-title">Book your treatment</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Book" asp-route-year="@Model.Year" asp-route-month="@Model.Month">
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label">Treatment</label>
                            <select asp-for="Input.SpaServiceId" id="bookingService" class="form-select spa-select" required>
                                <option value="">Choose a treatment</option>
                                @foreach (var service in Model.Services)
                                {
                                    <option value="@service.Id" data-duration="@service.DurationMinutes" data-price="@service.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-tea="@service.IncludesHerbalTea.ToString().ToLowerInvariant()">@service.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date</label>
                            <input asp-for="Input.Date" id="bookingDate" type="date" min="@Model.TodayLocal.ToString("yyyy-MM-dd")" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control spa-input" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Available time</label>
                            <select asp-for="Input.StartTime" id="bookingTime" class="form-select spa-select" required>
                                <option value="">Choose a treatment and date first</option>
                            </select>
                            <div id="slotLoading" class="spa-field-help d-none"><i class="fa-solid fa-spinner fa-spin"></i> Checking live availability…</div>
                        </div>
                        <div class="col-12">
                            <div id="bookingSummary" class="spa-booking-summary d-none"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Anything Kea should know? <span class="text-muted">(optional)</span></label>
                            <textarea asp-for="Input.CustomerNote" class="form-control spa-input" rows="3" maxlength="1000" placeholder="Pressure preference, areas to avoid, or any other note..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn spa-btn-ghost" data-bs-dismiss="modal">Not now</button>
                    <button type="submit" class="btn spa-btn-primary"><i class="fa-regular fa-calendar-check"></i> Confirm booking</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const bookingModal = new bootstrap.Modal(document.getElementById('bookingModal'));
    const serviceSelect = document.getElementById('bookingService');
    const dateInput = document.getElementById('bookingDate');
    const timeSelect = document.getElementById('bookingTime');
    const loading = document.getElementById('slotLoading');
    const summary = document.getElementById('bookingSummary');
    const previewService = document.getElementById('previewService');
    const previewSlots = document.getElementById('previewSlots');
    let preserveSelectedSlotOnNextShow = false;
    let bookingSlotsRequestId = 0;
    let previewSlotsRequestId = 0;

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value ?? '';
        return element.innerHTML;
    }

    async function fetchSlots(serviceId, date) {
        if (!serviceId || !date) return [];
        const url = `@Url.Page("/Index", "Availability")&serviceId=${encodeURIComponent(serviceId)}&date=${encodeURIComponent(date)}`;
        const response = await fetch(url, {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin'
        });
        if (!response.ok) throw new Error(`Availability request failed with ${response.status}`);
        return await response.json();
    }

    async function loadBookingSlots() {
        const requestId = ++bookingSlotsRequestId;
        const serviceId = serviceSelect.value;
        const date = dateInput.value;
        timeSelect.innerHTML = '<option value="">Checking availability...</option>';
        loading.classList.remove('d-none');
        try {
            const slots = await fetchSlots(serviceId, date);
            if (requestId !== bookingSlotsRequestId) return;

            timeSelect.innerHTML = slots.length
                ? '<option value="">Choose a time</option>' + slots.map(x => `<option value="${escapeHtml(x.value)}">${escapeHtml(x.label)}</option>`).join('')
                : '<option value="">No available slots for this date</option>';
        } catch (error) {
            if (requestId !== bookingSlotsRequestId) return;
            console.error(error);
            timeSelect.innerHTML = '<option value="">Could not load availability — please try again</option>';
        } finally {
            if (requestId === bookingSlotsRequestId)
                loading.classList.add('d-none');
        }
        if (requestId === bookingSlotsRequestId)
            updateSummary();
    }

    function updateSummary() {
        const option = serviceSelect.selectedOptions[0];
        if (!option || !option.value || !dateInput.value || !timeSelect.value) {
            summary.classList.add('d-none');
            return;
        }
        const rawPrice = option.dataset.price || '0';
        const parsedPrice = Number.parseFloat(rawPrice);
        const price = Number.isFinite(parsedPrice) ? parsedPrice : 0;
        const duration = option.dataset.duration || '';
        const tea = option.dataset.tea === 'true';
        const serviceName = escapeHtml(option.textContent.split(' · ')[0]);
        const appointmentDate = escapeHtml(dateInput.value);
        const appointmentTime = escapeHtml(timeSelect.value);
        summary.innerHTML = `<div><span>Your appointment</span><strong>${serviceName}</strong></div><div><span>When</span><strong>${appointmentDate} at ${appointmentTime}</strong></div><div><span>Duration</span><strong>${escapeHtml(duration)} min</strong></div><div><span>Price</span><strong>R${price.toFixed(0)}</strong></div>${tea ? '<p><i class="fa-solid fa-mug-hot"></i> Complimentary herbal tea included with this treatment.</p>' : ''}`;
        summary.classList.remove('d-none');
    }

    serviceSelect.addEventListener('change', loadBookingSlots);
    dateInput.addEventListener('change', loadBookingSlots);
    timeSelect.addEventListener('change', updateSummary);

    document.querySelectorAll('.js-book-slot').forEach(btn => {
        btn.addEventListener('click', async () => {
            serviceSelect.value = previewService.value;
            dateInput.value = btn.dataset.date;
            await loadBookingSlots();
            timeSelect.value = btn.dataset.time;
            updateSummary();
            preserveSelectedSlotOnNextShow = true;
            bookingModal.show();
        });
    });

    previewService.addEventListener('change', async () => {
        const requestId = ++previewSlotsRequestId;
        previewSlots.innerHTML = '<span class="spa-no-slots"><i class="fa-solid fa-spinner fa-spin"></i> Checking…</span>';
        try {
            const slots = await fetchSlots(previewService.value, '@Model.SelectedDate.ToString("yyyy-MM-dd")');
            if (requestId !== previewSlotsRequestId) return;

            previewSlots.innerHTML = slots.length
                ? slots.map(x => `<button type="button" class="spa-slot-pill dynamic-book-slot" data-time="${escapeHtml(x.value)}">${escapeHtml(x.value)}</button>`).join('')
                : '<span class="spa-no-slots">No available slots</span>';

            previewSlots.querySelectorAll('.dynamic-book-slot').forEach(btn => btn.addEventListener('click', async () => {
                serviceSelect.value = previewService.value;
                dateInput.value = '@Model.SelectedDate.ToString("yyyy-MM-dd")';
                await loadBookingSlots();
                timeSelect.value = btn.dataset.time;
                updateSummary();
                preserveSelectedSlotOnNextShow = true;
                bookingModal.show();
            }));
        } catch (error) {
            if (requestId !== previewSlotsRequestId) return;
            console.error(error);
            previewSlots.innerHTML = '<span class="spa-no-slots">Could not load availability. Try again.</span>';
        }
    });

    document.getElementById('bookingModal').addEventListener('shown.bs.modal', async () => {
        if (preserveSelectedSlotOnNextShow) {
            preserveSelectedSlotOnNextShow = false;
            return;
        }

        if (!serviceSelect.value) serviceSelect.value = '@Model.SelectedServiceId';
        if (!dateInput.value) dateInput.value = '@Model.SelectedDate.ToString("yyyy-MM-dd")';
        await loadBookingSlots();
    });
})();
</script>
}
