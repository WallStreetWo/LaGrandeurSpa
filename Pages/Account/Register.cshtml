@page
@model LaGrandeurSpa.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
    ViewData["HideNavigation"] = true;
}

<div class="spa-register-shell">
    <div class="spa-auth-card spa-register-card">
        <div class="text-center mb-4">
            <img src="~/img/la-grandeur-logo.jpeg" class="spa-register-logo" alt="La Grandeur Spa" />
            <span class="spa-kicker d-block mt-3">YOUR SPA ACCOUNT</span>
            <h1 class="spa-register-title">Create your account</h1>
            <p class="text-muted">Register once, then book and manage your appointments from your calendar.</p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                    <input asp-for="Input.FullName" class="form-control spa-input" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label">Email address</label>
                    <input asp-for="Input.Email" class="form-control spa-input" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.MobileNumber" class="form-label">Mobile number</label>
                    <input asp-for="Input.MobileNumber" class="form-control spa-input" />
                    <span asp-validation-for="Input.MobileNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <div class="spa-input-wrap spa-password-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Input.Password" type="password" class="form-control spa-input" autocomplete="new-password" />
                        <button type="button" class="spa-password-toggle js-password-toggle" data-password-target="Input_Password" aria-label="Show password" title="Show password"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <div class="spa-input-wrap spa-password-wrap">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control spa-input" autocomplete="new-password" />
                        <button type="button" class="spa-password-toggle js-password-toggle" data-password-target="Input_ConfirmPassword" aria-label="Show password" title="Show password"><i class="fa-regular fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <button class="btn spa-btn-primary w-100 mt-4" type="submit">Create account</button>
            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="spa-text-link"><i class="fa-solid fa-arrow-left me-1"></i> Back to sign in</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
